{
  "mcpServers": {
    "inboxtether": {
      "command": "/opt/inboxtether/.venv/bin/python",
      "args": [
        "/opt/inboxtether/server.py"
      ],
      "env": {
        "INBOXTETHER_IMAP_HOST": "mail.example.com",
        "INBOXTETHER_ACCOUNT": "owner@example.com",
        "INBOXTETHER_PASSWORD_FILE": "/etc/inboxtether-reader/imap-password",
        "INBOXTETHER_MOVES": "0"
      }
    }
  }
}
