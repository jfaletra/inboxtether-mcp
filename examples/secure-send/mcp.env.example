# Disabled by default. Preparation/status only, not permission to approve or send.
INBOXTETHER_SEND_ASSISTANT=0
INBOXTETHER_SEND_MODE=secure
INBOXTETHER_SEND_SOCKET=/run/inboxtether-send/request.sock
# Replace with the separately provisioned sender account's numeric UID.
INBOXTETHER_SEND_UID=2002
# Keep SMTP credentials/configuration OUT of this environment and MCP's account.
