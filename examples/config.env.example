# Example values only. Configure via your MCP client or service manager.
# This file is not automatically loaded by Python. Never add the password here.
INBOXTETHER_IMAP_HOST=mail.example.com
INBOXTETHER_ACCOUNT=user@example.com
INBOXTETHER_PASSWORD_FILE=/etc/inboxtether-mcp/imap-password

# Reader Mode stays the default. Do not enable without separate operator approval.
INBOXTETHER_DRAFT_ASSISTANT=0
# Future opt-in requires an existing special-use Drafts folder and protected state.
# INBOXTETHER_DRAFTS_FOLDER=Drafts
# INBOXTETHER_DRAFT_STATE_DIR=/var/lib/inboxtether-mcp/draft-state
# No SMTP configuration is supported.

# Browser approval is a separate opt-in; the terminal remains an admin fallback.
INBOXTETHER_BROWSER_APPROVAL=0
# When approved for use, match these with broker/web configuration:
# INBOXTETHER_REVIEW_ORIGIN=https://review.example.com
# INBOXTETHER_APPROVAL_ISSUER=https://identity.example.com
# INBOXTETHER_APPROVAL_SUBJECT=replace-with-immutable-oidc-subject

# Draft approval policy: secure (default) or basic. Master switch above stays 0.
INBOXTETHER_DRAFT_MODE=secure
# Required ONLY for explicit Basic Mode; blank means Basic Mode fails closed.
# Set to I_ACCEPT_CLIENT_CONTROLLED_APPROVAL after reviewing docs/DRAFT-MODES.md.
INBOXTETHER_BASIC_ACK=

# Optional generated HTML compatibility alternative; disabled by default.
# Requires Draft Assistant opt-in. No model-supplied HTML is accepted.
# Apply the same value to the MCP process and independent approval worker.
INBOXTETHER_DRAFT_HTML_ALTERNATIVE=0
