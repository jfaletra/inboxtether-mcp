# Standalone reference site; do not install into an existing production frontend automatically.
# Put limit_req_zone in the nginx http context; put the server there too.
limit_req_zone $binary_remote_addr zone=inboxtether_review:10m rate=5r/s;
server {
    listen 443 ssl;
    server_name review.example.com;
    ssl_certificate /etc/inboxtether-approval/tls/fullchain.pem;
    ssl_certificate_key /etc/inboxtether-approval/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 8k;
    client_body_timeout 10s;
    limit_req zone=inboxtether_review burst=20 nodelay;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store, private" always;
    location / {
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Authorization "";
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Cache-Control;
        proxy_hide_header Strict-Transport-Security;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_buffering off;
    }
}
