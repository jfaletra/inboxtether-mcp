# Template only; not automatically loaded. Leave both switches off until approved.
INBOXTETHER_DRAFT_ASSISTANT=0
INBOXTETHER_BROWSER_APPROVAL=0
INBOXTETHER_REVIEW_ORIGIN=https://review.example.com
INBOXTETHER_APPROVAL_ISSUER=https://identity.example.com
INBOXTETHER_APPROVAL_SUBJECT=replace-with-immutable-oidc-subject
INBOXTETHER_APPROVAL_AUDIENCE=replace-with-registered-client-id
INBOXTETHER_APPROVAL_JWKS_URL=https://identity.example.com/replace-with-provider-jwks-path
INBOXTETHER_APPROVAL_SOCKET=/run/inboxtether-approval-broker/broker.sock
INBOXTETHER_WEB_SOCKET=/run/inboxtether-approval-web/web.sock
INBOXTETHER_CSRF_KEY_FILE=/etc/inboxtether-approval/web/csrf.bin
# This environment belongs only to the web service. No mailbox password or OIDC client secret.
