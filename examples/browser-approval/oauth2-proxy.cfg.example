# OAuth2 Proxy v7.15.5 reference configuration. Template, not an installed service.
# Register a confidential OIDC web client and verify the provider before enablement.
provider = "oidc"
provider_display_name = "Your sign-in provider"
oidc_issuer_url = "https://identity.example.com"
client_id = "replace-with-registered-client-id"
client_secret_file = "/etc/inboxtether-approval/auth/client.secret"
redirect_url = "https://review.example.com/oauth2/callback"
scope = "openid profile email"
email_domains = ["example.com"]
code_challenge_method = "S256"
whitelist_domains = ["review.example.com"]

# Dedicated HTTPS frontend -> local OAuth2 Proxy -> private web-service Unix socket.
http_address = "127.0.0.1:4180"
reverse_proxy = true
upstreams = ["unix:///run/inboxtether-approval-web/web.sock"]
pass_host_header = true
pass_authorization_header = true
pass_access_token = false
pass_basic_auth = false
pass_user_headers = false
set_authorization_header = false
skip_auth_strip_headers = true
skip_jwt_bearer_tokens = false
# No skip-auth-route, trusted-IP bypass, htpasswd or TLS-verification bypass.

cookie_name = "__Host-inboxtether-auth"
cookie_secret_file = "/etc/inboxtether-approval/auth/cookie.secret"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_path = "/"
cookie_expire = "30m"
cookie_refresh = "5m"
cookie_csrf_per_request = true
cookie_csrf_per_request_limit = 5
cookie_csrf_expire = "10m"
request_logging = false
auth_logging = false
standard_logging = false
show_debug_on_error = false
